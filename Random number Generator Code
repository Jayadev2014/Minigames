import java.util.Random;
import java.util.Scanner;
public class Main{
  public static void main(String[] args){
    Scanner scanner = new Scanner(System.in);

    Random rand = new Random();
    
    System.out.println("Welcome to the Random Number Generator");

    System.out.print("Choose a min to generate a random number: ");
    int min = scanner.nextInt();
    
    System.out.print("Choose a max to generate a random number: ");
    
    int max = scanner.nextInt();

    if (max < min){
          System.out.println("Please choose different numbers as max is less than min");
    }

   
    else{
      
    int randomNum = rand.nextInt((max - min) + 1) + min;
   
   // 5,6,7. This will be our sample. In this case 7 is the max and 5 is the min so 7-5 = 2
   // +1 to that is 3 so our simplified version is rand.nextInt(3) + 5
   // 3 +5 = 8 and not 7
   // Because the program will look through 0-7 and not 1-8

   

   System.out.println("Your random number is " + randomNum);


    }


    
      

    


    scanner.close();
  } 
} 
